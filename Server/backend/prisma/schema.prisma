// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------
// ENUMS
// ------------------------------------------------------

enum Departamento {
  INGENIERIA
  MANTENIMIENTO
  ADMINISTRACION
}

enum RolUsuario {
  ADMINISTRADOR
  SUPERVISOR_ALMACEN
  ALMACENISTA
  OPERADOR
}

enum EstadoHerramienta {
  ACTIVA
  EN_MANTENIMIENTO
  DADA_DE_BAJA
}

enum TipoAccion {
  CREACION
  MODIFICACION
  ELIMINACION 
}

enum EstadoPedido {
  PENDIENTE
  DEVUELTO
}

// ------------------------------------------------------
// MODELOS PRINCIPALES
// ------------------------------------------------------

model Usuario {
  id            Int          @id @default(autoincrement())
  nombre        String
  numTrabajador Int          @unique
  contrasena    String
  depart        Departamento @default(INGENIERIA)
  rol           RolUsuario   @default(OPERADOR)
  tarjetaRfid   Int?         @unique 
  creadoEn      DateTime     @default(now())

  movimientos        HistorialHerramienta[]
  pedidosPrestados   Pedido[] @relation("PrestadorPedido")
  pedidosRecibidos   Pedido[] @relation("ReceptorPedido")
  
  recepcionesParciales DevolucionParcial[] @relation("RecepcionesParciales")
}

model Herramienta {
  id                 Int               @id @default(autoincrement())
  codigo             String            @unique
  nombre             String
  descripcion        String?
  marca              String?           
  
  cantidad           Int               @default(0)
  cantidadDisponible Int               @default(0)
  cantidadMinima     Int               @default(0)
  
  imagen             String?             
  estado             EstadoHerramienta @default(ACTIVA)
  
  creadoEn           DateTime          @default(now())
  actualizadoEn      DateTime          @updatedAt
  
  tipo               String?   
  ubicacion          String?   

  historial          HistorialHerramienta[]
  detallesPedido     DetallePedido[]
}

model HistorialHerramienta {
  id            Int          @id @default(autoincrement())
  accion        TipoAccion   
  fecha         DateTime     @default(now())
  
  detalle       String?     
  
  herramientaId Int?
  herramienta   Herramienta? @relation(fields: [herramientaId], references: [id])
  
  usuarioId     Int
  usuario       Usuario      @relation(fields: [usuarioId], references: [id])
}

model Pedido {
  id               Int          @id @default(autoincrement())
  
  trabajadorNumero String       
  trabajadorNombre String

  prestadorId      Int
  prestador        Usuario      @relation("PrestadorPedido", fields: [prestadorId], references: [id])

  receptorId       Int?
  receptor         Usuario?     @relation("ReceptorPedido", fields: [receptorId], references: [id])

  fechaPedido      DateTime     @default(now())
  fechaDevolucion  DateTime?    
  
  estado           EstadoPedido @default(PENDIENTE)

  detalles         DetallePedido[]
}

model DetallePedido {
  id                Int          @id @default(autoincrement())
  
  pedidoId          Int
  pedido            Pedido       @relation(fields: [pedidoId], references: [id])
  
  herramientaId     Int
  herramienta       Herramienta  @relation(fields: [herramientaId], references: [id])
  
  cantidadPrestada  Int
  cantidadRegresada Int          @default(0)

  // NUEVA RELACIÓN: El historial de recepciones de esta herramienta específica
  devoluciones      DevolucionParcial[]
}

model DevolucionParcial {
  id               Int           @id @default(autoincrement())
  
  detalleId        Int
  detalle          DetallePedido @relation(fields: [detalleId], references: [id])
  
  receptorId       Int
  receptor         Usuario       @relation("RecepcionesParciales", fields: [receptorId], references: [id])
  
  cantidadDevuelta Int
  fechaDevolucion  DateTime      @default(now())
}