// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ------------------------------------------------------
// ENUMS
// ------------------------------------------------------

enum Departamento {
  INGENIERIA
  MANTENIMIENTO
  ADMINISTRACION
}

enum RolUsuario {
  ADMINISTRADOR
  SUPERVISOR_ALMACEN
  ALMACENISTA
  OPERADOR
}

enum EstadoHerramienta {
  ACTIVA
  EN_MANTENIMIENTO
  DADA_DE_BAJA
}

enum TipoAccion {
  CREACION
  MODIFICACION
  ELIMINACION 
}

enum EstadoSalida {
  PENDIENTE
  DEVUELTO
}

// ------------------------------------------------------
// MODELOS PRINCIPALES
// ------------------------------------------------------

model Usuario {
  id            Int          @id @default(autoincrement())
  nombre        String
  numTrabajador Int          @unique
  contrasena    String
  depart        Departamento @default(INGENIERIA)
  rol           RolUsuario   @default(OPERADOR)
  tarjetaRfid   Int?         @unique 
  creadoEn      DateTime     @default(now())

  movimientos          HistorialHerramienta[]
  salidasPrestadas     Salida[] @relation("PrestadorSalida")
  salidasRecibidas     Salida[] @relation("ReceptorSalida")
  
  recepcionesParciales DevolucionParcial[] @relation("RecepcionesParciales")
}

model Herramienta {
  id                 Int               @id @default(autoincrement())
  codigo             String            @unique
  nombre             String
  descripcion        String?
  marca              String?           
  
  cantidad           Int               @default(0)
  cantidadDisponible Int               @default(0)
  cantidadMinima     Int               @default(0)
  cantidadMaxima     Int?              @default(0) 
  
  imagen             String?             
  estado             EstadoHerramienta @default(ACTIVA)
  
  creadoEn           DateTime          @default(now())
  actualizadoEn      DateTime          @updatedAt
  
  tipo               String?   
  ubicacion          String?   

  historial          HistorialHerramienta[]
  detallesSalida     DetalleSalida[]
}

model HistorialHerramienta {
  id            Int          @id @default(autoincrement())
  accion        TipoAccion   
  fecha         DateTime     @default(now())
  
  detalle       String?     
  
  herramientaId Int?
  herramienta   Herramienta? @relation(fields: [herramientaId], references: [id])
  
  usuarioId     Int
  usuario       Usuario      @relation(fields: [usuarioId], references: [id])
}

model Salida {
  id               Int          @id @default(autoincrement())
  
  trabajadorNumero String       
  trabajadorNombre String

  numeroOrden      String?      // String por si la orden lleva letras (ej. OT-123)
  numeroMaquina    String?      // String por si la máquina es (ej. CNC-04)

  motivo       String?  // Ej: "fin de vida util", "daño por operador", etc.
  motivoOtro   String?  // Texto libre si el motivo es "otro"

  prestadorId      Int
  prestador        Usuario      @relation("PrestadorSalida", fields: [prestadorId], references: [id])

  receptorId       Int?
  receptor         Usuario?     @relation("ReceptorSalida", fields: [receptorId], references: [id])

  fechaSalida      DateTime     @default(now()) // CAMBIO: de fechaPedido a fechaSalida
  fechaDevolucion  DateTime?    
  
  estado           EstadoSalida @default(PENDIENTE)

  detalles         DetalleSalida[]
}

model DetalleSalida {
  id                Int          @id @default(autoincrement())
  
  salidaId          Int          // CAMBIO: de pedidoId a salidaId
  salida            Salida       @relation(fields: [salidaId], references: [id])
  
  herramientaId     Int
  herramienta       Herramienta  @relation(fields: [herramientaId], references: [id])
  
  cantidadPrestada  Int
  cantidadRegresada Int          @default(0)

  devoluciones      DevolucionParcial[]
}

model DevolucionParcial {
  id               Int           @id @default(autoincrement())
  
  detalleId        Int
  detalle          DetalleSalida @relation(fields: [detalleId], references: [id])
  
  receptorId       Int
  receptor         Usuario       @relation("RecepcionesParciales", fields: [receptorId], references: [id])
  
  cantidadDevuelta Int
  fechaDevolucion  DateTime      @default(now())
}