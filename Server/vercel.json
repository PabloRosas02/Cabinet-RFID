{
  "buildCommand": "cd backend && npm install && npx prisma generate && cd ../Front-cabinet && npm install && npm run build",
  "outputDirectory": "Front-cabinet/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/pendientes",
      "schedule": "* * * * *"
    }
  ]
}