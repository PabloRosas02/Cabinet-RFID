// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

// Indicamos que usaremos el cliente de Node.js
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "linux-musl"]
}

// Indicamos que el motor es PostgreSQL y la URL viene del archivo .env
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------
// ENUMS
// ------------------------------------------------------

enum Departamento {
  INGENIERIA
  MANTENIMIENTO
  ADMINISTRACION
}

enum RolUsuario {
  ADMINISTRADOR       // Acceso total al sistema
  SUPERVISOR_ALMACEN  // Puede agregar/modificar herramientas y stock
  ALMACENISTA         // Solo procesa salidas y regresos
  OPERADOR            // Solo interactúa con el sistema físico
}

enum EstadoHerramienta {
  ACTIVA
  EN_MANTENIMIENTO
  DADA_DE_BAJA
}

// Enum para la Bitácora de Auditoría
enum TipoAccion {
  CREACION
  MODIFICACION
  ELIMINACION // Representará el Soft Delete (cambio de estado a DADA_DE_BAJA)
}

enum EstadoPedido {
  PENDIENTE
  DEVUELTO
}

// ------------------------------------------------------
// MODELOS PRINCIPALES
// ------------------------------------------------------

model Usuario {
  id            Int          @id @default(autoincrement())
  nombre        String
  numTrabajador Int          @unique
  contrasena    String
  depart        Departamento @default(INGENIERIA)
  rol           RolUsuario   @default(OPERADOR)
  tarjetaRfid   Int?         @unique 
  creadoEn      DateTime     @default(now())

  // Relación: Movimientos y acciones (Bitácora)
  movimientos   HistorialHerramienta[]

  // Relaciones duales con los Pedidos
  pedidosPrestados   Pedido[] @relation("PrestadorPedido")
  pedidosRecibidos   Pedido[] @relation("ReceptorPedido")
}

model Herramienta {
  id                 Int               @id @default(autoincrement())
  codigo             String            @unique
  nombre             String
  descripcion        String?
  marca              String?           
  
  // Control de Stock
  cantidad           Int               @default(0)
  cantidadDisponible Int               @default(0)
  cantidadMinima     Int               @default(0)
  
  // Multimedia
  imagen             String?           
  
  estado             EstadoHerramienta @default(ACTIVA)
  
  creadoEn           DateTime          @default(now())
  actualizadoEn      DateTime          @updatedAt
  
  tipo               String?   
  ubicacion          String?   

  // Relación: Historial de todas las modificaciones de esta herramienta
  historial          HistorialHerramienta[]
  
  // Relación: Detalles de préstamos donde se ha incluido esta herramienta
  detallesPedido     DetallePedido[]
}

model HistorialHerramienta {
  id            Int          @id @default(autoincrement())
  accion        TipoAccion   
  fecha         DateTime     @default(now())
  
  herramientaId Int?
  herramienta   Herramienta? @relation(fields: [herramientaId], references: [id])
  
  usuarioId     Int
  usuario       Usuario      @relation(fields: [usuarioId], references: [id])
}

model Pedido {
  id               Int          @id @default(autoincrement())
  
  // Datos del Solicitante (El trabajador que se lleva la herramienta)
  trabajadorNumero String       
  trabajadorNombre String

  prestadorId      Int
  prestador        Usuario      @relation("PrestadorPedido", fields: [prestadorId], references: [id])

  receptorId       Int?
  receptor         Usuario?     @relation("ReceptorPedido", fields: [receptorId], references: [id])

  // Tiempos
  fechaPedido      DateTime     @default(now())
  fechaDevolucion  DateTime?    
  
  estado           EstadoPedido @default(PENDIENTE)

  // Relación con el detalle de herramientas
  detalles         DetallePedido[]
}

model DetallePedido {
  id               Int          @id @default(autoincrement())
  
  pedidoId         Int
  pedido           Pedido       @relation(fields: [pedidoId], references: [id])
  
  herramientaId    Int
  herramienta      Herramienta  @relation(fields: [herramientaId], references: [id])
  
  cantidadPrestada Int
  cantidadRegresada Int         @default(0)
}